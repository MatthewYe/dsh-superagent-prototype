#!/usr/bin/env python3
"""Deprecated forwarding alias for `scripts/dsh-superagent`.

The host-native supervisor took the primary name when ADR 0004 superseded the Docker-first
deployment. Existing tmux sessions, cron jobs and scripts that still call this name keep working;
new callers should use `scripts/dsh-superagent` directly.
"""

import os
from pathlib import Path
import sys

TARGET = Path(__file__).resolve().with_name('dsh-superagent')
if not TARGET.is_file():
    print(f'{TARGET} is missing; restore scripts/dsh-superagent.', file=sys.stderr)
    sys.exit(1)
os.execv(sys.executable, [sys.executable, str(TARGET), *sys.argv[1:]])
